    {
      "name": "3 \u2013 Vector / Knowledge API (direct :8082, no auth)",
      "description": "/internal/** is permitted without JWT on the vector service. Call directly on port 8082 \u2014 the gateway does not route /internal paths.",
      "item": [
        {
          "name": "Ingest \u2013 Symptom Knowledge",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('chunksCreated > 0', () => {",
                  "    const j = pm.response.json();",
                  "    pm.expect(j.chunksCreated).to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"agentType\": \"SYMPTOM\",\n  \"documents\": [\n    {\n      \"sourceId\": \"symptom-doc-001\",\n      \"content\": \"Fever above 38\u00b0C combined with stiff neck and sensitivity to light may indicate bacterial meningitis, which requires immediate emergency care. Headache accompanied by fever and body aches is commonly associated with influenza. Persistent fatigue, night sweats, and unexplained weight loss are classic warning signs of lymphoma.\",\n      \"chunkSizeTokens\": 200,\n      \"overlapTokens\": 30,\n      \"metadata\": { \"source\": \"medical-textbook\", \"version\": \"2024\" }\n    },\n    {\n      \"sourceId\": \"symptom-doc-002\",\n      \"content\": \"Chest pain radiating to the left arm, jaw, or back alongside shortness of breath is a hallmark of acute myocardial infarction. Sudden severe headache described as the worst of one's life may indicate a subarachnoid hemorrhage. Abdominal pain in the right lower quadrant that worsens with movement is classic for appendicitis.\",\n      \"chunkSizeTokens\": 200,\n      \"overlapTokens\": 30,\n      \"metadata\": { \"source\": \"emergency-medicine-guide\", \"version\": \"2024\" }\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{VECTOR_URL}}/internal/knowledge/ingest",
              "host": [
                "{{VECTOR_URL}}"
              ],
              "path": [
                "internal",
                "knowledge",
                "ingest"
              ]
            }
          }
        },
