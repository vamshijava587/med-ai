{
  "info": {
    "name": "Med-AI Platform",
    "description": "Complete Postman collection for the med-ai multi-agent AI platform.\n\n## Setup\n1. Set `BASE_URL` to `http://localhost:8080` (via API Gateway) or per-service ports for direct access.\n2. Run the **Generate JWT** pre-request script once \u2014 it auto-sets `jwt_token` and `user_id`.\n3. All `/api/v1/**` requests require the `Authorization: Bearer {{jwt_token}}` header (auto-set).\n4. `/internal/**` (vector service) and `/actuator/health` are open \u2014 no token needed.\n\n## JWT Secret\nDefault secret: `change-this-32-char-jwt-secret-key`\nTo change, update the `JWT_SECRET` collection variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "AUTH_SERVICE_URL",
      "value": "http://localhost:8083",
      "type": "string"
    },
    {
      "key": "ORCHESTRATOR_URL",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "VECTOR_URL",
      "value": "http://localhost:8082",
      "type": "string"
    },
    {
      "key": "INTERNAL_API_KEY",
      "value": "medai-internal-secret",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "user-123",
      "type": "string"
    },
    {
      "key": "session_id",
      "value": "session-abc",
      "type": "string"
    },
    {
      "key": "token_expires_at",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "event": [],
  "item": [
    {
      "name": "0 \u2013 Auth Service",
      "description": "Central auth-service on port 8083. Use 'Generate Token' first \u2014 it stores jwt_token automatically. All Chat API requests use that token.",
      "item": [
        {
          "name": "Generate Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Token returned', () => pm.expect(j.token).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('jwt_token', j.token);",
                  "pm.collectionVariables.set('token_expires_at', j.expiresAt);",
                  "console.log('Token stored. Expires:', j.expiresAt);",
                  "pm.test('userId matches', () => pm.expect(j.userId).to.equal(pm.collectionVariables.get('user_id')));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{user_id}}\",\n  \"roles\": [\"USER\"]\n}"
            },
            "url": {
              "raw": "{{AUTH_SERVICE_URL}}/auth/token",
              "host": [
                "{{AUTH_SERVICE_URL}}"
              ],
              "path": [
                "auth",
                "token"
              ]
            },
            "description": "Calls auth-service to generate a signed HS256 JWT. The Test script auto-saves the token to {{jwt_token}}.\n\nChange `user_id` in collection variables to test different users.\n\n**Roles available:** USER, ADMIN"
          }
        },
        {
          "name": "Generate Admin Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('jwt_token', j.token);",
                  "console.log('Admin token stored. Expires:', j.expiresAt);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{user_id}}\",\n  \"roles\": [\"USER\", \"ADMIN\"]\n}"
            },
            "url": {
              "raw": "{{AUTH_SERVICE_URL}}/auth/token",
              "host": [
                "{{AUTH_SERVICE_URL}}"
              ],
              "path": [
                "auth",
                "token"
              ]
            }
          }
        },
        {
          "name": "Validate Token (internal)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('valid=true', () => pm.expect(j.valid).to.be.true);",
                  "pm.test('subject matches user_id', () => pm.expect(j.claims.subject).to.equal(pm.collectionVariables.get('user_id')));",
                  "console.log('Token valid until:', j.expiresAt);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Internal-Api-Key",
                "value": "{{INTERNAL_API_KEY}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{jwt_token}}\"\n}"
            },
            "url": {
              "raw": "{{AUTH_SERVICE_URL}}/internal/auth/validate",
              "host": [
                "{{AUTH_SERVICE_URL}}"
              ],
              "path": [
                "internal",
                "auth",
                "validate"
              ]
            },
            "description": "Called internally by all microservices to validate a token. Protected by X-Internal-Api-Key header.\n\nYou can use this to debug token issues directly."
          }
        },
        {
          "name": "Validate Token \u2013 Missing API Key (Negative)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Should be 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{jwt_token}}\"\n}"
            },
            "url": {
              "raw": "{{AUTH_SERVICE_URL}}/internal/auth/validate",
              "host": [
                "{{AUTH_SERVICE_URL}}"
              ],
              "path": [
                "internal",
                "auth",
                "validate"
              ]
            }
          }
        },
        {
          "name": "Validate Expired/Invalid Token (Negative)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('valid=false', () => pm.expect(pm.response.json().valid).to.be.false);",
                  "pm.test('errorMessage present', () => pm.expect(pm.response.json().errorMessage).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Internal-Api-Key",
                "value": "{{INTERNAL_API_KEY}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"this.is.not.a.valid.token\"\n}"
            },
            "url": {
              "raw": "{{AUTH_SERVICE_URL}}/internal/auth/validate",
              "host": [
                "{{AUTH_SERVICE_URL}}"
              ],
              "path": [
                "internal",
                "auth",
                "validate"
              ]
            }
          }
        },
        {
          "name": "Auth Service Health",
