              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has answer', () => {",
                  "    const j = pm.response.json();",
                  "    pm.expect(j.answer).to.be.a('string').and.not.empty;",
